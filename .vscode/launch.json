{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/bowling-email-subscriber",
            "args": [
                "main:create_app",
                "--factory",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
